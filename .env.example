# Copie ce fichier en .env puis : chmod 600 .env
# Ne commit jamais le .env (déjà dans .gitignore).

# --- Site de notes de frais ---
EXPENSE_SITE_URL=https://exemple.example.com
EXPENSE_USERNAME=
EXPENSE_PASSWORD=
# true = navigateur invisible, false = pour déboguer en voyant le navigateur
EXPENSE_HEADLESS=true

# --- Serveur d'upload local (depuis l'iPhone) ---
# 127.0.0.1 = uniquement depuis cette machine (recommandé).
# Mets l'IP LAN de la machine (ex: 192.168.1.20) UNIQUEMENT si tu uploads
# depuis l'iPhone sur le même Wi-Fi, derrière le pare-feu, jamais exposé à Internet.
UPLOAD_HOST=127.0.0.1
SERVER_PORT=4789
# Token long et aléatoire requis dans l'en-tête X-Token de chaque upload.
# Génère-en un avec : openssl rand -hex 32
SERVER_TOKEN=change-moi

# --- Divers ---
# Moteur OCR : tesseract (local, gratuit, par défaut) ou mistral (cloud, payant, meilleure qualité)
OCR_PROVIDER=tesseract
OCR_LANG=fra
# Si OCR_PROVIDER=mistral (clé jamais loguée, jamais commitée) :
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
DATA_DIR=
